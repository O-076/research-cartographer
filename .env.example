# ============================================================
# .env.example — Copy this to .env and fill in your values
# NEVER commit .env — only .env.example is safe to commit
# ============================================================

# ------------------------------------------------------------
# Azure AI Foundry IQ
# Get from: Azure Portal → AI Foundry → Your workspace → Keys
# ------------------------------------------------------------
AZURE_FOUNDRY_IQ_ENDPOINT=
AZURE_FOUNDRY_IQ_KEY=
AZURE_FOUNDRY_IQ_KB_ID=

# ------------------------------------------------------------
# Azure OpenAI
# Get from: Azure Portal → Azure OpenAI → Your resource → Keys
# ------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Semantic Scholar (No API key needed for the free tier!)

# ------------------------------------------------------------
# Neo4j AuraDB
# Get from: console.neo4j.io → Your instance → Connect
# ------------------------------------------------------------
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# ------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MAX_PAPERS=20
MAX_CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_SIMILARITY_THRESHOLD=0.60
CLAIM_DEDUP_THRESHOLD=0.95
